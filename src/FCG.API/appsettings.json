{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FCG_Db;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "FCG.API",
    "Audience": "FCG.Clients",
    "SecretKey": "ESTE-E-UM-SEGREDO-DE-DESENVOLVIMENTO-USE-OUTRO-EM-PRODUCAO-1234567890",
    "ExpirationMinutes": 120
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "fcg",
    "LibraryCollection": "library_items"
  },
  "AllowedHosts": "*"
}
